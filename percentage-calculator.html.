<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Percentage Calculator - Calculate Percentages Easily</title>
  <meta name="description" content="Calculate percentages, find what percent one number is of another, and work out percentage increases or decreases with this free calculator.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://daily-money-taupe.vercel.app/percentage-calculator.html">

  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f3f6fb;
      color: #202938;
      line-height: 1.6;
    }
    header {
      background: #123b70;
      color: white;
      text-align: center;
      padding: 24px 15px;
    }
    main {
      max-width: 760px;
      margin: 25px auto;
      padding: 0 15px;
    }
    .card {
      background: white;
      padding: 22px;
      border-radius: 14px;
      margin-bottom: 20px;
      box-shadow: 0 3px 15px #0000000c;
    }
    label {
      display: block;
      font-weight: bold;
      margin-top: 14px;
    }
    input, button {
      width: 100%;
      padding: 12px;
      margin-top: 6px;
      border-radius: 8px;
      font-size: 16px;
    }
    input { border: 1px solid #cbd5e1; }
    button {
      border: 0;
      background: #1762ad;
      color: white;
      font-weight: bold;
      cursor: pointer;
      margin-top: 18px;
    }
    .result {
      background: #edf7ff;
      padding: 15px;
      border-radius: 9px;
      margin-top: 15px;
      overflow-wrap: anywhere;
    }
    nav, footer { text-align: center; padding: 16px; }
    footer { background: #123b70; color: white; }
    footer a { color: white; margin: 5px; }
  </style>
</head>

<body>
  <header>
    <h1>Percentage Calculator</h1>
    <p>Calculate percentages and percentage changes</p>
  </header>

  <nav>
    <a href="index.html">Home</a>
  </nav>

  <main>
    <section class="card">
      <h2>What Is X% of a Number?</h2>
      <p>Find a percentage of any number.</p>

      <label for="percent">Percentage (%)</label>
      <input id="percent" type="number" step="any" placeholder="e.g. 25">

      <label for="number">Number</label>
      <input id="number" type="number" step="any" placeholder="e.g. 200">

      <button type="button" onclick="calculatePart()">Calculate</button>
      <div id="result1" class="result" aria-live="polite">Your result will appear here.</div>
    </section>

    <section class="card">
      <h2>What Percentage Is One Number of Another?</h2>
      <p>Find what percentage one number represents of another.</p>

      <label for="part">First Number</label>
      <input id="part" type="number" step="any" placeholder="e.g. 30">

      <label for="whole">Total Number</label>
      <input id="whole" type="number" step="any" placeholder="e.g. 150">

      <button type="button" onclick="calculateRatio()">Calculate Percentage</button>
      <div id="result2" class="result" aria-live="polite">Your result will appear here.</div>
    </section>

    <section class="card">
      <h2>Percentage Increase or Decrease</h2>
      <p>Compare an original value with a new value.</p>

      <label for="oldValue">Original Value</label>
      <input id="oldValue" type="number" step="any" placeholder="e.g. 100">

      <label for="newValue">New Value</label>
      <input id="newValue" type="number" step="any" placeholder="e.g. 120">

      <button type="button" onclick="calculateChange()">Calculate Change</button>
      <div id="result3" class="result" aria-live="polite">Your result will appear here.</div>
    </section>

    <section class="card">
      <h2>Percentage Formulas</h2>
      <p><strong>Percentage of a number:</strong> Percentage ÷ 100 × Number</p>
      <p><strong>Percentage share:</strong> Part ÷ Total × 100</p>
      <p><strong>Percentage change:</strong> (New value − Original value) ÷ Original value × 100</p>

      <h2>Frequently Asked Questions</h2>
      <h3>What is 20% of 100?</h3>
      <p>20% of 100 is 20.</p>

      <h3>What does a negative percentage change mean?</h3>
      <p>A negative change means the new value is lower than the original value.</p>
    </section>
  </main>

  <footer>
    <p>© 2026 Daily Money Tools</p>
    <a href="about.html">About</a>
    <a href="contact.html">Contact</a>
    <a href="privacy-policy.html">Privacy Policy</a>
    <a href="disclaimer.html">Disclaimer</a>
  </footer>

  <script>
    function readNumber(id) {
      const value = document.getElementById(id).value.trim();
      if (value === "") return null;
      const number = Number(value);
      return Number.isFinite(number) ? number : null;
    }

    function calculatePart() {
      const percent = readNumber("percent");
      const number = readNumber("number");
      const result = document.getElementById("result1");

      if (percent === null || number === null) {
        result.textContent = "Please enter valid values in both fields.";
        return;
      }

      const answer = percent / 100 * number;
      result.textContent = `${percent}% of ${number} = ${answer}`;
    }

    function calculateRatio() {
      const part = readNumber("part");
      const whole = readNumber("whole");
      const result = document.getElementById("result2");

      if (part === null || whole === null || whole === 0) {
        result.textContent = "Enter valid numbers. The total number cannot be zero.";
        return;
      }

      const answer = part / whole * 100;
      result.textContent = `${part} is ${answer.toFixed(2)}% of ${whole}.`;
    }

    function calculateChange() {
      const oldValue = readNumber("oldValue");
      const newValue = readNumber("newValue");
      const result = document.getElementById("result3");

      if (oldValue === null || newValue === null || oldValue === 0) {
        result.textContent = "Enter valid values. The original value cannot be zero.";
        return;
      }

      const change = (newValue - oldValue) / Math.abs(oldValue) * 100;
      const label = change > 0 ? "Increase" : change < 0 ? "Decrease" : "No change";

      result.textContent = `${label}: ${Math.abs(change).toFixed(2)}%`;
    }
  </script>
</body>
</html>
