<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Discount Calculator - Calculate Sale Prices and Savings</title>
  <meta name="description" content="Calculate discounts, sale prices and savings with this free online discount calculator.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://daily-money-taupe.vercel.app/discount-calculator.html">

  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f3f6fb;
      color: #202938;
      line-height: 1.6;
    }
    header {
      background: #123b70;
      color: white;
      text-align: center;
      padding: 24px 15px;
    }
    main {
      max-width: 720px;
      margin: 25px auto;
      padding: 0 15px;
    }
    .card {
      background: white;
      padding: 22px;
      border-radius: 14px;
      margin-bottom: 20px;
      box-shadow: 0 3px 15px #0000000c;
    }
    label {
      display: block;
      font-weight: bold;
      margin-top: 14px;
    }
    input, button {
      width: 100%;
      padding: 12px;
      margin-top: 6px;
      border-radius: 8px;
      font-size: 16px;
    }
    input { border: 1px solid #cbd5e1; }
    button {
      border: 0;
      background: #1762ad;
      color: white;
      font-weight: bold;
      cursor: pointer;
      margin-top: 20px;
    }
    .result {
      background: #edf7ff;
      padding: 15px;
      border-radius: 9px;
      margin-top: 18px;
      overflow-wrap: anywhere;
    }
    nav, footer { text-align: center; padding: 16px; }
    a { color: #14579b; }
    footer { background: #123b70; color: white; }
    footer a { color: white; margin: 5px; }
  </style>
</head>

<body>
  <header>
    <h1>Discount Calculator</h1>
    <p>Find your sale price and savings in seconds</p>
  </header>

  <nav>
    <a href="index.html">Home</a>
  </nav>

  <main>
    <section class="card">
      <h2>Calculate Your Discount</h2>
      <p>Enter the original price and discount percentage.</p>

      <label for="price">Original Price</label>
      <input id="price" type="number" min="0" step="0.01" placeholder="e.g. 100">

      <label for="discount">Discount Percentage (%)</label>
      <input id="discount" type="number" min="0" max="100" step="0.1" placeholder="e.g. 20">

      <button type="button" onclick="calculateDiscount()">Calculate Discount</button>

      <div id="result" class="result" aria-live="polite">
        Your discount result will appear here.
      </div>
    </section>

    <section class="card">
      <h2>How to Calculate a Discount</h2>
      <p>
        A discount reduces the original price by a percentage. This calculator
        shows the amount saved and the price after the discount.
      </p>

      <h3>Discount Formula</h3>
      <p>Money Saved = Original Price × Discount Percentage ÷ 100</p>
      <p>Sale Price = Original Price − Money Saved</p>

      <h3>Example</h3>
      <p>
        If an item costs $100 and has a 20% discount, you save $20.
        The sale price is $80 before any additional taxes or fees.
      </p>
    </section>

    <section class="card">
      <h2>Frequently Asked Questions</h2>

      <h3>What does a 20% discount mean?</h3>
      <p>
        It means the price is reduced by 20% of the original price.
      </p>

      <h3>Does this include sales tax?</h3>
      <p>
        No. This calculator calculates the discount only. Any applicable
        taxes or additional fees are not included.
      </p>
    </section>
  </main>

  <footer>
    <p>© 2026 Daily Money Tools</p>
    <a href="about.html">About</a>
    <a href="contact.html">Contact</a>
    <a href="privacy-policy.html">Privacy Policy</a>
    <a href="disclaimer.html">Disclaimer</a>
  </footer>

  <script>
    function calculateDiscount() {
      const priceInput = document.getElementById("price").value.trim();
      const discountInput = document.getElementById("discount").value.trim();
      const price = Number(priceInput);
      const discount = Number(discountInput);
      const result = document.getElementById("result");

      if (
        priceInput === "" ||
        discountInput === "" ||
        !Number.isFinite(price) ||
        !Number.isFinite(discount) ||
        price < 0 ||
        discount < 0 ||
        discount > 100
      ) {
        result.textContent =
          "Please enter a valid price and a discount between 0% and 100%.";
        return;
      }

      const saved = price * discount / 100;
      const salePrice = price - saved;

      result.innerHTML = `
        <p><strong>Original Price:</strong> ${price.toFixed(2)}</p>
        <p><strong>Discount:</strong> ${discount.toFixed(2)}%</p>
        <p><strong>You Save:</strong> ${saved.toFixed(2)}</p>
        <p><strong>Final Sale Price:</strong> ${salePrice.toFixed(2)}</p>
      `;
    }
  </script>
</body>
</html>
